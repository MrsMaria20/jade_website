---
/*
  ServicesPreview.astro

  What it is: the home page's services section on warm paper: a header, two
  "starting point" cards (Launch and Studio), a three-step strip, the founding
  clients offer, and a link to the full Services page.
  Where it's used: src/pages/index.astro, right after the hero. The hero's
  "See our services" button scrolls here (id "services").
  Which mockup it matches: the packages section in
  reference/source/02-ff2-site-home.html. Copy is from site-plan.md.

  No prices appear here by design: budget and exact scope are settled on a call.
*/

import SectionIntro from './SectionIntro.astro';
import PackageCard from './PackageCard.astro';
import Button from './Button.astro';

// What each starting point includes. Launch items are confirmed; Studio's list
// is kept general because each Studio project is scoped on a call.
const launchIncludes = [
  'A contact form',
  'A booking link',
  'Search basics set up',
  'Your domain connected',
];

const studioIncludes = [
  'Everything in Launch',
  'More pages, as your business needs',
  'Scope confirmed on a call',
];

// The three steps from first conversation to a live site.
const steps = [
  {
    name: 'Talk it through',
    text: 'We define what your site needs, together.',
  },
  {
    name: 'We build it',
    text: "We handle every step. You don't need to learn a site builder.",
  },
  {
    name: "You're live",
    text: 'Your site goes live on your own domain.',
  },
];
---

<!-- ===== SERVICES PREVIEW: paper section after the hero ===== -->
<section
  id="services"
  class="bg-paper px-6 py-20 text-ink md:py-[120px] lg:px-[104px]"
>
  <div class="mx-auto flex max-w-[1232px] flex-col gap-14">
    <!-- ===== HEADER: label and title on the left, one line on the right ===== -->
    <div data-reveal class="grid gap-8 md:grid-cols-2 md:items-end md:gap-20">
      <SectionIntro
        label="01 · SERVICES"
        title="Two ways to get your website live."
        surface="light"
      />
      <p class="max-w-[520px] text-[17px] leading-relaxed text-moss">
        Most projects start here. We confirm the exact scope on a call.
      </p>
    </div>

    <!-- ===== THE TWO STARTING POINTS ===== -->
    <div class="grid gap-5 md:grid-cols-2">
      <div data-reveal class="flex">
        <PackageCard
          class="w-full"
          name="Launch"
          tag="One to two pages"
          description="A focused site that puts your business in front of the right people and makes it easy to get in touch."
          includes={launchIncludes}
          timeline="About a week"
          tone="light"
        />
      </div>
      <div data-reveal class="flex">
        <PackageCard
          class="w-full"
          name="Studio"
          tag="Complete website"
          description="A complete website that represents your whole business, with a page for everything your customers look for."
          includes={studioIncludes}
          timeline="2 to 3 weeks"
          tone="dark"
        />
      </div>
    </div>

    <!-- The timeline only starts once there is something to build from. -->
    <p data-reveal class="-mt-6 text-sm leading-relaxed text-lichen">
      Timelines start once the scope is agreed and your content has arrived.
    </p>

    <!-- ===== THREE STEPS: how simple it is ===== -->
    <ol class="grid gap-8 border-t border-ink/15 pt-10 md:grid-cols-3 md:gap-10">
      {steps.map((step, index) => (
        <li data-reveal class="flex flex-col gap-3">
          <span class="eyebrow text-jade">Step {index + 1}</span>
          <h3 class="font-serif text-[30px] leading-none font-normal">
            {step.name}
          </h3>
          <p class="text-base leading-relaxed text-moss">{step.text}</p>
        </li>
      ))}
    </ol>

    <!-- ===== FOUNDING CLIENTS: dashed strip ===== -->
    <div
      data-reveal
      class="flex flex-col gap-5 rounded-[20px] border border-dashed border-ink/35 px-6 py-6 md:flex-row md:items-center md:justify-between md:gap-10 md:px-8"
    >
      <span class="eyebrow shrink-0 text-jade">Founding clients</span>
      <p class="grow text-base leading-normal text-moss">
        The first [NUMBER] projects are offered at a reduced rate, in exchange
        for a testimonial and permission to share the work.
      </p>
      <Button href="/contact" surface="light" class="shrink-0 self-start">
        Ask about a spot
      </Button>
    </div>

    <!-- ===== LINK TO THE FULL SERVICES PAGE ===== -->
    <div data-reveal>
      <Button href="/services" surface="light" arrow>
        See our services
      </Button>
    </div>
  </div>
</section>
