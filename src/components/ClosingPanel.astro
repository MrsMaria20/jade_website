---
/*
  ClosingPanel.astro

  What it is: the dark closing frame at the bottom of the home page. It invites
  the visitor to book a short call, offers an email option, and says honestly
  that AI assistants are coming soon. It is deliberately roomy: the founding
  clients offer lives in the "how it works" panel, so this one keeps open space.
  It is sized to fill one screen, like the panels above it, and the frame
  "opens like a window" as the visitor scrolls to it (src/scripts/frame-grow.ts).
  Where it's used: src/pages/index.astro, after the services section.
  Which mockup it matches: the closing frame in
  reference/source/02-ff2-site-home.html (dark rounded frame, glass booking card).
  The mockup's day-and-time picker is NOT built; the real booking happens in the
  Calendly embed on the Contact page (/contact#book).

  Copy is from site-plan.md. The email stays a visible [BRACKET] placeholder
  until contactEmail is set in src/data/site.ts.
*/

import BlurredField from './BlurredField.astro';
import SectionIntro from './SectionIntro.astro';
import GlassPanel from './GlassPanel.astro';
import Button from './Button.astro';
import { bookCallHref, contactEmail, emailPlaceholder } from '../data/site';
---

<!-- ===== CLOSING PANEL: dark frame with the field behind it ===== -->
<section id="contact" class="p-4">
  <div
    data-frame-grow
    class="relative min-h-[calc(100svh-32px)] overflow-hidden rounded-[28px] bg-field"
  >
    <!-- The same multi-tone field as the hero, with a different seed so it reads as its own place. No doves here. -->
    <BlurredField seed={7} />
    <img
      src="/grain.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.16] mix-blend-overlay"
    />

    <div class="relative z-10 flex min-h-[inherit] flex-col justify-center gap-[clamp(28px,5vh,56px)] px-6 py-[clamp(40px,7vh,110px)] md:px-[88px]">
      <!-- ===== TWO COLUMNS: invitation on the left, booking card on the right ===== -->
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-[60px]">
        <div data-reveal class="flex flex-col gap-6">
          <SectionIntro
            label="04 · CONTACT"
            title="Tell us about your business."
            intro="A 20-minute call about your business and what your website needs to do for it. You'll leave knowing the next step."
            surface="dark"
          />

          <!-- Email option, shown as a plain placeholder until the address is set. -->
          <p class="text-[15px] text-mist">
            Prefer to write?{' '}
            {contactEmail ? (
              <a
                href={`mailto:${contactEmail}`}
                class="border-b border-ivory/35 pb-0.5 text-ivory"
              >
                {contactEmail}
              </a>
            ) : (
              <span class="text-ivory">{emailPlaceholder}</span>
            )}
          </p>
        </div>

        <!-- ===== BOOKING CARD: glass panel over the field ===== -->
        <div data-reveal>
          <GlassPanel variant="panel" class="flex flex-col gap-6">
            <div class="flex flex-col gap-2">
              <h3 class="font-serif text-[30px] leading-tight font-normal">
                20-minute intro call
              </h3>
              <p class="text-base leading-relaxed text-mist">
                Choose a day and time that suits you.
              </p>
            </div>
            <Button href={bookCallHref} arrow class="self-start">
              Choose a time
            </Button>
          </GlassPanel>
        </div>
      </div>

      <!-- ===== COMING SOON: one honest line about AI assistants ===== -->
      <div
        data-reveal
        class="mt-[clamp(12px,5vh,56px)] flex flex-col gap-3 border-t border-ivory/[0.14] pt-8 md:flex-row md:items-baseline md:gap-8"
      >
        <span class="eyebrow shrink-0 text-sage">Coming soon</span>
        <p class="text-base leading-relaxed text-mist">
          AI assistants that handle the routine work, so you can focus on what
          matters most.{' '}
          {contactEmail ? (
            <a
              href={`mailto:${contactEmail}`}
              class="border-b border-ivory/35 pb-0.5 text-ivory"
            >
              Email us to hear first.
            </a>
          ) : (
            <span class="text-ivory">
              Email us to hear first: {emailPlaceholder}
            </span>
          )}
        </p>
      </div>
    </div>
  </div>
</section>
