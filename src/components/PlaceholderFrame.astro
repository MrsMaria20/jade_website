---
/*
  PlaceholderFrame.astro

  What it is: a TEMPORARY short hero used by the inner pages until their real
  content is built. It now uses the real HeroFrame, so it shows the final
  backdrop, field, grain, doves, and navigation.
  Where it's used: the placeholder pages (services, about, contact).
  Remove it: each page stops using it when its real content is built
  (Services, About, and Contact in build steps 5 to 7).
*/

import HeroFrame from './HeroFrame.astro';

interface Props {
  // Small label above the title, for example "Placeholder page".
  label: string;
  title: string;
  // One sentence saying what will replace this page.
  note: string;
}

const { label, title, note } = Astro.props;
---

<main id="main">
  <HeroFrame variant="short">
    <div class="flex min-h-[inherit] flex-col items-center justify-center gap-4 px-6 pt-24 pb-12 text-center">
      <p class="eyebrow text-sage">{label}</p>
      <h1 class="font-serif text-[46px] font-medium text-ivory md:text-8xl">
        {title}
      </h1>
      <p class="max-w-md text-mist">{note}</p>
    </div>
  </HeroFrame>
</main>
