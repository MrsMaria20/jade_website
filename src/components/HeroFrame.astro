---
/*
  HeroFrame.astro

  What it is: the dark, rounded frame at the top of every page. It stacks the
  blurred field, film grain, doves, and the notched navigation, and holds
  whatever hero content the page puts in its slot.
  Where it's used: the home hero (tall) and the short heroes on Services, About,
  and Contact. One component means every page gets the identical backdrop.
  Which mockup it matches: reference/source/01-field-and-flight-v2.html
  (16px inset, 28px corners) and heromockupex.png.

  Layer order, back to front: field, grain, doves, content, navigation.
*/

import BlurredField from './BlurredField.astro';
import AsciiDoves from './AsciiDoves.astro';
import Nav from './Nav.astro';

interface Props {
  // tall = the home hero (fills the first screen); short = inner-page heroes.
  variant?: 'tall' | 'short';
  // Show the flock of doves. On by default, as in the mockups.
  doves?: boolean;
  class?: string;
}

const {
  variant = 'short',
  doves = true,
  class: extraClasses = '',
} = Astro.props;

const heightClasses =
  variant === 'tall'
    ? 'min-h-[max(620px,calc(100svh-32px))]'
    : 'min-h-[520px] md:min-h-[640px]';
---

<!-- 16px inset from the window edge, as the brand guide requires. -->
<div class="p-4">
  <section
    data-hero-frame
    class:list={[
      'relative overflow-hidden rounded-[28px] bg-field',
      heightClasses,
      extraClasses,
    ]}
  >
    <!-- ===== LAYER 1: the blurred green field ===== -->
    <BlurredField />

    <!-- ===== LAYER 2: film grain over the field ===== -->
    <img
      src="/grain.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.16] mix-blend-overlay"
    />

    <!-- ===== LAYER 3: the doves ===== -->
    {doves && <AsciiDoves />}

    <!-- ===== LAYER 4: the page's hero content ===== -->
    <div class="relative z-10 min-h-[inherit]">
      <slot />
    </div>

    <!-- ===== LAYER 5: the notched navigation, cut into the top ===== -->
    <Nav />
  </section>
</div>

<style is:global>
  /*
    The hero entrance animation, in plain CSS so it needs no script and nothing is
    held back waiting for JavaScript to load (this is what keeps the first paint
    fast on a slow phone connection).

    - Headline lines (.hero-line) rise out of their mask, 0.16s apart.
    - Elements with data-hero-fade fade up after their own delay. The delay values
      in use are 0.2, 0.6, and 0.8 seconds; to use another, add a rule below.
    - The "both" fill mode holds the starting look during the delay, so nothing
      flashes before it animates.

    Only for visitors who have not asked for reduced motion; they see everything
    still and fully visible.
  */
  @media (prefers-reduced-motion: no-preference) {
    .hero-line {
      animation: hero-line-rise 1.2s var(--ease-calm) 0.1s both;
    }

    /* The second line of a headline starts 0.16s after the first. */
    span:nth-child(2) > .hero-line {
      animation-delay: 0.26s;
    }

    [data-hero-fade] {
      animation: hero-fade-up 1.1s var(--ease-calm) both;
    }

    [data-hero-fade='0.2'] {
      animation-delay: 0.2s;
    }

    [data-hero-fade='0.6'] {
      animation-delay: 0.6s;
    }

    [data-hero-fade='0.8'] {
      animation-delay: 0.8s;
    }
  }

  @keyframes hero-line-rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { initHeroMotion } from '../scripts/hero-motion';

  initHeroMotion();
</script>
