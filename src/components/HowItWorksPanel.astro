---
/*
  HowItWorksPanel.astro

  What it is: the second panel: the three steps from first conversation to a
  live site, set large so the panel fills one screen on its own.
  Where it's used: src/pages/index.astro, between the services panel and the
  contact panel (id "how-it-works").
  Which mockup it matches: the section openers and stage titles in
  reference/source/02-ff2-site-home.html (serif titles, mono labels, paper
  background). The mockup's pinned "bloom" version of this idea was removed.

  The point of this panel is that the process is simple for the client: they
  never have to learn a site builder. Copy is from site-plan.md.
*/

import SectionIntro from './SectionIntro.astro';

// The three steps from first conversation to a live site.
const steps = [
  {
    name: 'Talk it through',
    text: 'We define what your site needs, together.',
  },
  {
    name: 'We build it',
    text: "We handle every step. You don't need to learn a site builder.",
  },
  {
    name: "You're live",
    text: 'Your site goes live on your own domain.',
  },
];
---

<!-- ===== HOW IT WORKS: one screen tall, paper ===== -->
<section
  id="how-it-works"
  class="flex min-h-svh flex-col justify-center border-t border-ink/10 bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]"
>
  <div class="mx-auto flex w-full max-w-[1232px] flex-col gap-[clamp(40px,8vh,96px)]">
    <!-- ===== HEADER: the title fades in letter by letter as it scrolls into view ===== -->
    <SectionIntro
      label="02 · HOW IT WORKS"
      title="From first conversation to live site, in three steps."
      surface="light"
      scatter
      class="max-w-[900px]"
    />

    <!-- ===== THE THREE STEPS ===== -->
    <ol class="grid gap-10 md:grid-cols-3 md:gap-10">
      {steps.map((step, index) => (
        <li data-reveal class="flex flex-col gap-4 border-t border-ink/20 pt-6">
          <span class="eyebrow text-jade">Step {index + 1}</span>
          <h3 class="font-serif text-[36px] leading-none font-normal md:text-[44px]">
            {step.name}
          </h3>
          <p class="max-w-[320px] text-[17px] leading-relaxed text-moss">
            {step.text}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
