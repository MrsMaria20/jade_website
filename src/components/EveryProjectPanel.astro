---
/*
  EveryProjectPanel.astro

  What it is: a panel listing what every project gets, whichever starting point
  is chosen. Three short points, each in its own frosted-glass bubble, on a beige
  panel.
  Where it's used: src/pages/index.astro, after the "how it works" panel.
  Which mockup it matches: the glass hero card in heromockupex.png.

  How the glass works on beige: frosted glass only reads as glass when there is
  something to blur behind it, so this panel has a soft, light version of the
  field (sage and celadon washes over the beige). The glass is tinted white with
  a bright edge, so it stays light and sits in the beige, not on green.

  This is a plain full-width panel with no window-opening transition (that effect
  is on the contact panel only).

  There is no limit on how many glass panels a page can have (see
  brand/brand-guide.md); this panel simply shows three as one group.

  Only things the owner has confirmed are true of every project are listed here.
  Copy is from site-plan.md.
*/

import BlurredField from './BlurredField.astro';
import GlassPanel from './GlassPanel.astro';
import SectionIntro from './SectionIntro.astro';

// What every project includes (confirmed by the owner).
const points = [
  {
    name: 'Designed from scratch',
    text: 'Your site is designed around your business, not built from a template.',
  },
  {
    name: 'Works on every device',
    text: 'Built to work well on phones, tablets, and computers.',
  },
  {
    name: 'You own everything',
    text: 'Your domain, your site, and your accounts are in your name.',
  },
];
---

<!-- ===== EVERY PROJECT: one screen tall, beige with the light field ===== -->
<section id="every-project" class="p-0">
  <div class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]">
    <!-- The light field: soft sage and celadon washes over the beige. -->
    <BlurredField seed={33} tone="light" />

    <div class="relative z-10 mx-auto flex w-full max-w-[1232px] flex-col gap-[clamp(28px,6vh,72px)]">
      <!-- ===== HEADER ===== -->
      <div data-reveal>
        <SectionIntro
          label="03 · EVERY PROJECT"
          title="What you get either way."
          surface="light"
          class="max-w-[900px]"
        />
      </div>

      <!-- ===== THE THREE GLASS BUBBLES ===== -->
      <ul class="grid gap-4 md:grid-cols-3 md:gap-5">
        {points.map((point) => (
          <li data-reveal class="flex">
            <GlassPanel
              variant="light"
              class="flex w-full flex-col gap-4 md:p-[clamp(24px,4.5vh,36px)]"
            >
              <h3 class="font-serif text-[32px] leading-none font-normal text-ink md:text-[34px]">
                {point.name}
              </h3>
              <p class="text-[17px] leading-relaxed text-moss">{point.text}</p>
            </GlassPanel>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
