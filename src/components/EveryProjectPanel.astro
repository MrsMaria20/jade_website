---
/*
  EveryProjectPanel.astro

  What it is: a panel listing what every project gets, whichever starting point
  is chosen. Three short points, set large so the panel fills one screen.
  Where it's used: src/pages/index.astro, after the "how it works" panel.
  Which mockup it matches: the section openers and stage titles in
  reference/source/02-ff2-site-home.html (serif titles, mono labels, paper).

  Only things the owner has confirmed are true of every project are listed here.
  Copy is from site-plan.md.
*/

import SectionIntro from './SectionIntro.astro';

// What every project includes (confirmed by the owner).
const points = [
  {
    name: 'Designed from scratch',
    text: 'Your site is designed around your business, not built from a template.',
  },
  {
    name: 'Works on every device',
    text: 'Built to work well on phones, tablets, and computers.',
  },
  {
    name: 'You own everything',
    text: 'Your domain, your site, and your accounts are in your name.',
  },
];
---

<!-- ===== EVERY PROJECT: one screen tall, paper ===== -->
<section
  id="every-project"
  class="flex min-h-svh flex-col justify-center border-t border-ink/10 bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]"
>
  <div class="mx-auto flex w-full max-w-[1232px] flex-col gap-[clamp(40px,8vh,96px)]">
    <!-- ===== HEADER ===== -->
    <div data-reveal>
      <SectionIntro
        label="03 · EVERY PROJECT"
        title="What you get either way."
        surface="light"
        class="max-w-[900px]"
      />
    </div>

    <!-- ===== THE THREE POINTS ===== -->
    <ul class="grid gap-10 md:grid-cols-3 md:gap-10">
      {points.map((point) => (
        <li data-reveal class="flex flex-col gap-4 border-t border-ink/20 pt-6">
          <h3 class="font-serif text-[36px] leading-none font-normal md:text-[40px]">
            {point.name}
          </h3>
          <p class="max-w-[340px] text-[17px] leading-relaxed text-moss">
            {point.text}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
