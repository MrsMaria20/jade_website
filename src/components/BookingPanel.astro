---
/*
  BookingPanel.astro

  What it is: the Contact page's main panel: a short invitation and an email
  option on the left, the Calendly booking calendar on the right. One screen tall.
  Where it's used: src/pages/contact.astro, right after the hero. Every "Book a
  call" button on the site points here (id "book", reached via /contact#book).
  Which mockup it matches: the contact body in
  reference/source/02-ff2-site-contact.html (booking card plus email card). The
  mockup's project form is intentionally not built (see site-plan.md).

  Beige panel on the light field with a light-glass email card (see CLAUDE.md).
  Copy is from site-plan.md.
*/

import BlurredField from './BlurredField.astro';
import CalendlyEmbed from './CalendlyEmbed.astro';
import GlassPanel from './GlassPanel.astro';
import SectionIntro from './SectionIntro.astro';
import { contactEmail, emailPlaceholder } from '../data/site';
---

<!-- ===== BOOK A CALL: one screen tall, beige with the light field ===== -->
<section
  id="book"
  class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]"
>
  <BlurredField seed={77} tone="light" />

  <div class="relative z-10 mx-auto grid w-full max-w-[1232px] items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <!-- ===== LEFT: the invitation and the email option ===== -->
    <div data-reveal class="flex flex-col gap-[clamp(24px,5vh,48px)]">
      <SectionIntro
        label="01 · BOOK A CALL"
        title="Pick a time."
        intro="A 20-minute call about your business and what your website needs to do for it. You'll leave knowing the next step."
        surface="light"
        class="max-w-none"
      />

      <!-- Email option on a light-glass card. -->
      <GlassPanel variant="light" class="flex flex-col gap-2">
        <span class="font-mono text-[11px] tracking-[0.16em] text-moss uppercase">
          Prefer to write?
        </span>
        {contactEmail ? (
          <a
            href={`mailto:${contactEmail}`}
            class="w-fit font-serif text-[28px] leading-tight text-ink underline decoration-ink/30 underline-offset-4 transition-colors duration-500 ease-calm hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-jade motion-reduce:transition-none"
          >
            {contactEmail}
          </a>
        ) : (
          <span class="font-serif text-[28px] leading-tight text-ink">
            {emailPlaceholder}
          </span>
        )}
      </GlassPanel>
    </div>

    <!-- ===== RIGHT: the booking calendar ===== -->
    <div data-reveal>
      <CalendlyEmbed class="h-[clamp(520px,calc(100svh-clamp(120px,22vh,300px)),760px)]" />
    </div>
  </div>
</section>
