---
/*
  PackageCard.astro

  What it is: one "starting point" card, such as Launch or Studio: a name, a
  short tag, a one-line description, what's included, and a timeline.
  Where it's used: ServicesPreview.astro on the home page, and the Services page.
  Which mockup it matches: the two package cards in
  reference/source/02-ff2-site-home.html (26px corners, 52px serif name, mono tag).

  No prices appear on the site by design (see brand/voice-and-copy.md).
*/

interface Props {
  // The card's name, for example "Launch".
  name: string;
  // Small mono tag at the top right, for example "ONE TO TWO PAGES".
  tag: string;
  // One or two sentences saying what the starting point is.
  description: string;
  // What's included, one short phrase per item.
  includes: string[];
  // How long it usually takes, for example "1 to 2 weeks".
  timeline: string;
  // light = a card on paper; dark = an ink card on paper.
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  name,
  tag,
  description,
  includes,
  timeline,
  tone = 'light',
  class: extraClasses = '',
} = Astro.props;

const isDark = tone === 'dark';
---

<article
  class:list={[
    'group flex flex-col gap-[clamp(14px,2.2vh,20px)] rounded-[26px] p-7 md:p-[clamp(24px,4.5vh,36px)]',
    // Hover: the card rises a little and gains a soft shadow. Still under reduced motion.
    'transition-[transform,box-shadow] duration-500 ease-calm hover:-translate-y-1 hover:shadow-[0_28px_48px_-28px_rgba(28,36,31,0.45)] motion-reduce:transition-none motion-reduce:hover:translate-y-0',
    isDark ? 'bg-ink text-ivory' : 'bg-card text-ink',
    extraClasses,
  ]}
>
  <!-- ===== NAME AND TAG ===== -->
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="font-serif text-[44px] leading-none font-normal md:text-[52px]">
      {name}
    </h3>
    <span
      class:list={[
        'text-right font-mono text-[11px] tracking-[0.16em] uppercase',
        isDark ? 'text-sage' : 'text-lichen',
      ]}
    >
      {tag}
    </span>
  </div>

  <!-- ===== DESCRIPTION ===== -->
  <p
    class:list={[
      'text-base leading-relaxed',
      isDark ? 'text-mist' : 'text-moss',
    ]}
  >
    {description}
  </p>

  <!-- ===== WHAT'S INCLUDED ===== -->
  <ul
    class:list={[
      'flex flex-col gap-2.5 text-[15.5px] leading-snug',
      isDark ? 'text-mist' : 'text-moss',
    ]}
  >
    {includes.map((item) => (
      <li class="flex items-start gap-3">
        <span
          aria-hidden="true"
          class:list={[
            'mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full',
            isDark ? 'bg-sage' : 'bg-jade',
          ]}
        />
        {item}
      </li>
    ))}
  </ul>

  <!-- ===== TIMELINE: a thin line that draws across in color on hover ===== -->
  <div class="mt-auto">
    <div class:list={['relative h-px', isDark ? 'bg-ivory/15' : 'bg-ink/15']}>
      <span
        aria-hidden="true"
        class:list={[
          'absolute inset-0 origin-left scale-x-0 transition-transform duration-700 ease-calm group-hover:scale-x-100 motion-reduce:transition-none',
          isDark ? 'bg-sage' : 'bg-jade',
        ]}
      ></span>
    </div>
    <p
      class:list={[
        'pt-5 font-mono text-xs tracking-[0.08em] uppercase',
        isDark ? 'text-ivory' : 'text-ink',
      ]}
    >
      {timeline}
    </p>
  </div>
</article>
