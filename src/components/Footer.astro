---
/*
  Footer.astro

  What it is: the site footer, a dark rounded panel with a closing line, two
  buttons, link columns, and a copyright row.
  Where it's used: BaseLayout.astro, so it appears at the bottom of every page.
  Which mockup it matches: the footer in reference/source/02-ff2-site-home.html
  (96px closing line, 4 columns, mono copyright row), with the copy from site-plan.md.

  Placeholders: the email and social links show as visible [BRACKETS] until the
  real values are set in src/data/site.ts.
*/

import Button from './Button.astro';
import Logo from './Logo.astro';
import {
  mainLinks,
  socialLinks,
  bookCallHref,
  contactEmail,
  emailPlaceholder,
  siteDomain,
  siteName,
} from '../data/site';

const currentYear = new Date().getFullYear();

// Only accounts with a real link are shown; with none, the column is hidden.
const activeSocials = socialLinks.filter((social) => social.href);
const hasSocials = activeSocials.length > 0;
---

<footer class="px-4 pb-4">
  <div class="flex flex-col gap-14 rounded-[28px] bg-field px-6 pt-14 pb-8 text-ivory md:gap-[70px] md:px-[88px] md:pt-[90px] md:pb-9">
    <!-- ===== CLOSING LINE AND BUTTONS ===== -->
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-10">
      <h2 class="font-serif text-[48px] leading-[0.95] font-normal tracking-[-0.02em] md:text-[96px] md:leading-[0.9]">
        Websites built to represent you.
      </h2>

      <div class="flex flex-col gap-2.5 sm:flex-row">
        <Button href={bookCallHref} size="lg">
          Book a call
        </Button>
        {contactEmail ? (
          <Button href={`mailto:${contactEmail}`} variant="secondary" size="lg">
            {contactEmail}
          </Button>
        ) : (
          <span class="inline-flex h-[54px] items-center justify-center rounded-full border border-ivory/35 px-6 text-[15px] font-medium text-ivory whitespace-nowrap">
            {emailPlaceholder}
          </span>
        )}
      </div>
    </div>

    <!-- ===== LINK COLUMNS ===== -->
    <div
      class:list={[
        'grid grid-cols-2 gap-10 border-t border-ivory/[0.14] pt-10',
        hasSocials
          ? 'md:grid-cols-[1.4fr_1fr_1fr_1fr]'
          : 'md:grid-cols-[1.4fr_1fr_1fr]',
      ]}
    >
      <!-- Brand column -->
      <div class="col-span-2 flex flex-col gap-3 md:col-span-1">
        <Logo />
        <p class="max-w-[300px] text-[14.5px] leading-relaxed text-mist">
          A small web studio.
        </p>
      </div>

      <!-- Pages column -->
      <nav
        aria-label="Footer pages"
        class="flex flex-col gap-2.5 text-[14.5px] text-mist"
      >
        <h3 class="mb-1 font-mono text-[11px] font-normal tracking-[0.18em] text-sage uppercase">
          Pages
        </h3>
        {mainLinks.map((link) => (
          <a
            href={link.href}
            class="w-fit transition-colors duration-500 ease-calm hover:text-ivory focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celadon motion-reduce:transition-none"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Start column -->
      <div class="flex flex-col gap-2.5 text-[14.5px] text-mist">
        <h3 class="mb-1 font-mono text-[11px] font-normal tracking-[0.18em] text-sage uppercase">
          Start
        </h3>
        <a
          href={bookCallHref}
          class="w-fit transition-colors duration-500 ease-calm hover:text-ivory focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celadon motion-reduce:transition-none"
        >
          Book a call
        </a>
        {contactEmail ? (
          <a
            href={`mailto:${contactEmail}`}
            class="w-fit transition-colors duration-500 ease-calm hover:text-ivory focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celadon motion-reduce:transition-none"
          >
            Email
          </a>
        ) : (
          <span>{emailPlaceholder}</span>
        )}
      </div>

      <!-- Elsewhere column: only when at least one account has a real link -->
      {hasSocials && (
        <div class="flex flex-col gap-2.5 text-[14.5px] text-mist">
          <h3 class="mb-1 font-mono text-[11px] font-normal tracking-[0.18em] text-sage uppercase">
            Elsewhere
          </h3>
          {activeSocials.map((social) => (
            <a
              href={social.href}
              class="w-fit transition-colors duration-500 ease-calm hover:text-ivory focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celadon motion-reduce:transition-none"
            >
              {social.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- ===== COPYRIGHT ROW ===== -->
    <div class="flex flex-col gap-2 border-t border-ivory/[0.14] pt-5 font-mono text-[11px] tracking-[0.14em] text-sage uppercase md:flex-row md:justify-between">
      <span>
        © {currentYear} {siteName}
      </span>
      <span>{siteDomain}</span>
    </div>
  </div>
</footer>
