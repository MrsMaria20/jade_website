---
/*
  WhoWeArePanel.astro

  What it is: the About page's first content panel: what Jade Agentic is, in a
  couple of company-level sentences, with the Jade logo mark set large beside it.
  Where it's used: src/pages/about.astro, right after the hero.
  Which mockup it matches: the "01 · the person behind it" block in
  reference/source/02-ff2-site-about.html, but company-focused: no personal
  story and no portrait (the logo mark stands in for it).

  Beige panel on the light field (see CLAUDE.md), full width, one screen tall.
  The label, title, and paragraph sit together inside one tall light-glass panel,
  with the title at the top, the text lower down, and generous space between.
  The panel rises and gains a soft shadow on hover, like the home page cards.
  The logo sits on a frosted disc so it stands out; the mark itself is left
  untouched (the brand guide forbids shadows or effects on the logo).
  Only facts the owner has confirmed are used.
*/

import BlurredField from './BlurredField.astro';
import GlassPanel from './GlassPanel.astro';
import SectionIntro from './SectionIntro.astro';
---

<!-- ===== WHO WE ARE: one screen tall, beige with the light field ===== -->
<section
  id="who-we-are"
  class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]"
>
  <BlurredField seed={44} tone="light" />

  <div class="relative z-10 mx-auto grid w-full max-w-[1232px] items-center gap-12 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.65fr)] md:gap-16">
    <!-- ===== THE LOGO MARK on a frosted disc (ink on light, one color only) ===== -->
    <div data-reveal class="flex justify-center md:justify-start">
      <div class="glass-light flex aspect-square w-[min(100%,clamp(230px,50vh,460px))] items-center justify-center rounded-full">
        <img
          src="/logo/jade-disc-ink.svg"
          alt="The Jade Agentic mark: a jade bonsai tree inside a disc"
          width="320"
          height="320"
          class="h-[72%] w-[72%]"
        />
      </div>
    </div>

    <!-- ===== WHO WE ARE: one large glass panel holding the title and the text ===== -->
    <div data-reveal>
      <GlassPanel
        variant="light"
        class="flex flex-col justify-between gap-[clamp(36px,9vh,96px)] p-7! transition-[transform,box-shadow] duration-500 ease-calm hover:-translate-y-1 hover:shadow-[0_28px_48px_-28px_rgba(28,36,31,0.45)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 md:min-h-[clamp(440px,68vh,660px)] md:p-[clamp(36px,7vh,72px)]!"
      >
        <SectionIntro
          label="01 · WHO WE ARE"
          title="A web studio for businesses like yours."
          surface="light"
          class="max-w-none"
        />

        <div class="flex max-w-[620px] flex-col gap-5 text-[17px] leading-relaxed text-moss">
          <p>
            Jade Agentic is a web design and development studio for small to
            medium businesses. We build custom websites, designed so your brand
            resonates with the people you want to reach, and we handle every
            step from the first conversation to a live site.
          </p>
        </div>
      </GlassPanel>
    </div>
  </div>
</section>
