---
/*
  WhoWeArePanel.astro

  What it is: the About page's first content panel: what Jade Agentic is, in a
  couple of company-level sentences. One wide light-glass card holds the large
  logo mark on the left and, on the right, the label, title, and paragraph.
  Where it's used: src/pages/about.astro, right after the hero.
  Which mockup it matches: the owner's second reference layout for this panel
  (logo on the left, text on the right; the owner asked for no dividing line).
  Company-focused: no personal story, no portrait.

  ONE surface: the logo section and the text section share the exact same glass
  background (the reference had two shades; the owner asked for one), with no
  dividing line between them. The whole card lifts and gains a soft shadow on
  hover as a single piece; that hover effect comes from the glass style itself
  (src/styles/global.css), shared by every glass panel. The mark is ink on light, untouched (the brand guide forbids effects on it).

  Alignment (owner's request): the top of the title lines up with the top of the
  logo, and the bottom of the paragraph lines up with the bottom of the logo. Both
  use one shared size, the CSS variable --logo, so they stay in step at every
  screen size. The logo is large enough to leave a clear gap between the two.

  Beige panel on the light field (see CLAUDE.md), full width, one screen tall.
  Only facts the owner has confirmed are used.
*/

import BlurredField from './BlurredField.astro';
import GlassPanel from './GlassPanel.astro';
import SectionIntro from './SectionIntro.astro';
---

<!-- ===== WHO WE ARE: one screen tall, beige with the light field ===== -->
<section
  id="who-we-are"
  class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[88px]"
>
  <BlurredField seed={44} tone="light" />

  <div data-reveal class="relative z-10 mx-auto w-full max-w-[1260px]">
    <!-- One glass card; its two halves are NOT given separate backgrounds. -->
    <GlassPanel
      variant="light"
      class="grid p-0! [--logo:clamp(150px,30vh,260px)] md:[--logo:clamp(230px,43vh,390px)] md:min-h-[clamp(500px,78vh,760px)] md:grid-cols-[calc(var(--logo)+5rem)_minmax(0,1fr)]"
    >
      <!-- ===== LEFT: the logo mark, large (ink on light, one color only) ===== -->
      <div class="flex items-center justify-center px-8 py-10 md:p-10">
        <img
          src="/logo/jade-disc-ink.svg"
          alt="The Jade Agentic mark: a jade bonsai tree inside a disc"
          width="280"
          height="280"
          class="h-(--logo) w-(--logo)"
        />
      </div>

      <!-- ===== RIGHT: the label at the top of the card; the title and paragraph in a band as tall as the logo ===== -->
      <div class="relative flex flex-col gap-[clamp(24px,5vh,48px)] p-7 md:flex-row md:items-center md:p-[clamp(36px,7vh,80px)]">
        <p class="eyebrow text-moss md:absolute md:top-[clamp(36px,7vh,80px)] md:left-[clamp(36px,7vh,80px)]">
          01 · WHO WE ARE
        </p>

        <!-- The band: the title's top is the logo's top, the paragraph's bottom is the logo's bottom. -->
        <div class="flex flex-col gap-[clamp(24px,5vh,48px)] md:min-h-(--logo) md:justify-between md:gap-6">
          <SectionIntro
            title="A web studio for businesses like yours."
            surface="light"
            class="max-w-none text-balance"
          />

          <p class="max-w-[680px] text-[17px] leading-relaxed text-pretty text-moss">
            Jade Agentic is a web design and development studio for small to
            medium businesses. We build custom websites, designed so your brand
            resonates with the people you want to reach, and we handle every
            step from the first conversation to a live site.
          </p>
        </div>
      </div>
    </GlassPanel>
  </div>
</section>
