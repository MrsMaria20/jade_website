---
/*
  WhoWeArePanel.astro

  What it is: the About page's first content panel: what Jade Agentic is, in a
  couple of company-level sentences. One wide, centered light-glass card holds
  the small logo mark, a thin divider, the label, the title, and the paragraph,
  all centered.
  Where it's used: src/pages/about.astro, right after the hero.
  Which mockup it matches: the owner's reference layout for this panel (a centered
  glass card with the mark on top). Company-focused: no personal story, no portrait.

  Beige panel on the light field (see CLAUDE.md), full width, one screen tall.
  The card rises and gains a soft shadow on hover, like the home page cards.
  The mark is ink on light, untouched (the brand guide forbids effects on the logo).
  Only facts the owner has confirmed are used.
*/

import BlurredField from './BlurredField.astro';
import GlassPanel from './GlassPanel.astro';
import SectionIntro from './SectionIntro.astro';
---

<!-- ===== WHO WE ARE: one screen tall, beige with the light field ===== -->
<section
  id="who-we-are"
  class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]"
>
  <BlurredField seed={44} tone="light" />

  <div data-reveal class="relative z-10 mx-auto w-full max-w-[1040px]">
    <GlassPanel
      variant="light"
      class="flex flex-col items-center justify-between gap-[clamp(40px,9vh,104px)] p-7! text-center transition-[transform,box-shadow] duration-500 ease-calm hover:-translate-y-1 hover:shadow-[0_28px_48px_-28px_rgba(28,36,31,0.45)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 md:min-h-[clamp(520px,82vh,780px)] md:p-[clamp(36px,7vh,80px)]!"
    >
      <!-- ===== TOP GROUP: the mark, divider, label, and title, kept together near the top ===== -->
      <div class="flex flex-col items-center gap-[clamp(18px,3.4vh,34px)]">
        <!-- ===== THE LOGO MARK, small, at the top (ink on light, one color only) ===== -->
        <img
          src="/logo/jade-disc-ink.svg"
          alt="The Jade Agentic mark: a jade bonsai tree inside a disc"
          width="96"
          height="96"
          class="h-[clamp(64px,10vh,96px)] w-[clamp(64px,10vh,96px)]"
        />

        <!-- A thin divider under the mark. -->
        <span aria-hidden="true" class="h-px w-[72px] bg-ink/25"></span>

        <!-- ===== LABEL AND TITLE, centered ===== -->
        <SectionIntro
          label="01 · WHO WE ARE"
          title="A web studio for businesses like yours."
          surface="light"
          class="max-w-none items-center text-center text-balance"
        />
      </div>

      <!-- ===== THE PARAGRAPH ===== -->
      <p class="max-w-[720px] text-[17px] leading-relaxed text-moss">
        Jade Agentic is a web design and development studio for small to medium
        businesses. We build custom websites, designed so your brand resonates
        with the people you want to reach, and we handle every step from the
        first conversation to a live site.
      </p>
    </GlassPanel>
  </div>
</section>
