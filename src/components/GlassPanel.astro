---
/*
  GlassPanel.astro

  What it is: a frosted-glass container that lets the moving field show through.
  Where it's used: the hero card (variant "hero") and the booking card in the
  closing panel (variant "panel").
  Which mockup it matches: reference/source/01-field-and-flight-v2.html (hero card)
  and reference/source/02-ff2-site-home.html (booking card).

  Rules from CLAUDE.md: only on top of the field, at most two per screen, never
  on paper sections, and text inside stays at least 16px.
  The glass look itself lives in src/styles/global.css (.glass-hero, .glass-panel).
*/

interface Props {
  // hero = the card on the hero; panel = interactive cards on dark.
  variant?: 'hero' | 'panel';
  class?: string;
}

const { variant = 'hero', class: extraClasses = '' } = Astro.props;

const glassClass = variant === 'hero' ? 'glass-hero' : 'glass-panel';
---

<div class:list={[glassClass, 'p-6 text-ivory md:p-8', extraClasses]}>
  <slot />
</div>
