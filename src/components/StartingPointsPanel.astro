---
/*
  StartingPointsPanel.astro

  What it is: the Services page's main panel: Launch and Studio in more depth
  than on the home page, each with who it suits, what's included, and a
  timeline in plain words. Sized to fill one screen.
  Where it's used: src/pages/services.astro, right after the hero.
  Which mockup it matches: the packages section in
  reference/source/02-ff2-site-services.html (light and dark cards side by side).
  The mockup's add-ons picker and revision-rounds table are intentionally not
  built: scope and revisions are settled on a call (see site-plan.md).

  No prices appear here by design.
*/

import SectionIntro from './SectionIntro.astro';
import PackageCard from './PackageCard.astro';

// What each starting point includes. Launch items are confirmed; Studio's list
// is kept general because each Studio project is scoped on a call.
const launchIncludes = [
  'A contact form',
  'A booking link',
  'Search basics set up',
  'Your domain connected',
];

const studioIncludes = [
  'Everything in Launch',
  'More pages, as your business needs',
  'Scope confirmed on a call',
];
---

<!-- ===== STARTING POINTS: one screen tall, paper ===== -->
<section
  id="starting-points"
  class="flex min-h-svh flex-col justify-center bg-paper px-6 py-[clamp(40px,7vh,110px)] text-ink lg:px-[104px]"
>
  <div class="mx-auto flex w-full max-w-[1232px] flex-col gap-[clamp(20px,4.2vh,56px)]">
    <!-- ===== HEADER ===== -->
    <div data-reveal>
      <SectionIntro
        label="01 · STARTING POINTS"
        title="Which one fits your business?"
        surface="light"
        class="max-w-[1100px]!"
      />
    </div>

    <!-- ===== THE TWO STARTING POINTS ===== -->
    <div class="grid gap-5 md:grid-cols-2">
      <div data-reveal class="flex">
        <PackageCard
          class="w-full"
          name="Launch"
          tag="One to two pages"
          description="A focused site that puts your business in front of the right people and makes it easy to get in touch."
          bestFor="New businesses, single offers, or anyone who needs a clear presence online quickly."
          includes={launchIncludes}
          timeline="About a week"
          tone="light"
        />
      </div>
      <div data-reveal class="flex">
        <PackageCard
          class="w-full"
          name="Studio"
          tag="Complete website"
          description="A complete website that represents your whole business, with a page for everything your customers look for."
          bestFor="Established businesses that need a full website with a page for everything customers look for."
          includes={studioIncludes}
          timeline="2 to 3 weeks"
          tone="dark"
        />
      </div>
    </div>

    <!-- The timeline only starts once there is something to build from. -->
    <p data-reveal class="-mt-4 text-sm leading-relaxed text-lichen">
      Timelines start once the scope is agreed and your content has arrived.
    </p>
  </div>
</section>
