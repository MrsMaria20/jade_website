---
/*
  SectionIntro.astro

  What it is: the opening of a content section: a small mono label, a serif
  title, and an optional intro paragraph.
  Where it's used: the services panel, the Services and About pages, and any
  other section that starts with a label and a headline.
  Which mockup it matches: the section openers in reference/source/02-ff2-site-home.html
  (label, 46px to 76px serif title, 16 to 17px body).

  Optional "scatter" mode: the title is split into letters that fade in at
  random as it scrolls into view (see src/scripts/scatter-reveal.ts). The split
  happens here, at build time, so there is no layout shift. A screen-reader copy
  of the plain title is kept, and the letters are hidden from assistive tech.
*/

interface Props {
  // Small uppercase label above the title, for example "02 · TWO WAYS TO START".
  label?: string;
  // The section headline.
  title: string;
  // One short paragraph under the title.
  intro?: string;
  // The background the section sits on: dark (the field) or light (paper).
  surface?: 'dark' | 'light';
  // Fade the title in letter by letter as it scrolls into view.
  scatter?: boolean;
  class?: string;
}

const {
  label,
  title,
  intro,
  surface = 'dark',
  scatter = false,
  class: extraClasses = '',
} = Astro.props;

// Dark sections use ivory, mist, and celadon. Beige sections use ink and moss.
// Small labels avoid sage (on the green field) and jade (on the light field):
// both fail the 4.5:1 contrast rule over the brighter strokes (measured).
const labelColor = surface === 'dark' ? 'text-celadon' : 'text-moss';
const titleColor = surface === 'dark' ? 'text-ivory' : 'text-ink';
const introColor = surface === 'dark' ? 'text-mist' : 'text-moss';

// For scatter mode: the title as words, each word as letters. Words are kept
// together (never broken mid-word) and the spaces between them stay normal.
const words = title.split(' ').map((word) => [...word]);
---

<div class:list={['flex max-w-3xl flex-col gap-5', extraClasses]}>
  {label && (
    <p
      data-reveal={scatter ? '' : undefined}
      class:list={['eyebrow', labelColor]}
    >
      {label}
    </p>
  )}
  <h2
    class:list={[
      'font-serif text-[46px] leading-[0.95] font-normal tracking-[-0.02em] md:text-[clamp(52px,9.5vh,76px)]',
      titleColor,
    ]}
  >
    {scatter ? (
      <>
        <span class="sr-only">{title}</span>
        <span aria-hidden="true" data-scatter>
          {words.map((letters, wordIndex) => (
            <>
              <span class="inline-block whitespace-nowrap">
                {letters.map((letter) => (
                  <span data-char>{letter}</span>
                ))}
              </span>
              {wordIndex < words.length - 1 && ' '}
            </>
          ))}
        </span>
      </>
    ) : (
      title
    )}
  </h2>
  {intro && (
    <p class:list={['text-[17px] leading-relaxed', introColor]}>{intro}</p>
  )}
</div>
