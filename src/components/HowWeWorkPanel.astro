---
/*
  HowWeWorkPanel.astro

  What it is: the About page's "how we work" panel: three short points about
  what it is like to work with Jade Agentic, on the green field.
  Where it's used: src/pages/about.astro, between "who we are" and "what's next".
  Which mockup it matches: the "02 · how I work" block in
  reference/source/02-ff2-site-about.html (rewritten for a company voice).

  Green panel, full width, one screen tall, so the page alternates colour
  (green hero, beige, THIS, beige, green contact).

  Copy is from site-plan.md. The points are drafts built from things the owner
  has said; the owner confirms them before launch (first version, to review).
*/

import BlurredField from './BlurredField.astro';
import SectionIntro from './SectionIntro.astro';

// Three points about working with the studio.
const points = [
  {
    name: 'No handoffs',
    text: 'The people you meet are the people who build your site.',
  },
  {
    name: 'Scope agreed first',
    text: 'We agree what your site needs, and the budget, with you on a call before the work begins.',
  },
  {
    name: 'Straight answers',
    text: 'AI assistants and agentic workflows are coming soon, not here today. We say plainly what is ready and what is not.',
  },
];
---

<!-- ===== HOW WE WORK: one screen tall, the green field ===== -->
<section
  id="how-we-work"
  class="relative flex min-h-svh flex-col justify-center overflow-hidden bg-field px-6 py-[clamp(40px,7vh,110px)] text-ivory lg:px-[104px]"
>
  <BlurredField seed={55} />

  <!-- A dark veil over the field keeps the small text easy to read. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-night/35"
  ></div>

  <img
    src="/grain.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.16] mix-blend-overlay"
  />

  <div class="relative z-10 mx-auto flex w-full max-w-[1232px] flex-col gap-[clamp(40px,8vh,96px)]">
    <div data-reveal>
      <SectionIntro
        label="02 · HOW WE WORK"
        title="What working with us is like."
        surface="dark"
        class="max-w-[900px]"
      />
    </div>

    <ul class="grid gap-10 md:grid-cols-3 md:gap-10">
      {points.map((point) => (
        <li
          data-reveal
          class="flex flex-col gap-4 border-t border-ivory/25 pt-6"
        >
          <h3 class="font-serif text-[36px] leading-none font-normal text-ivory md:text-[40px]">
            {point.name}
          </h3>
          <p class="max-w-[340px] text-[17px] leading-relaxed text-mist">
            {point.text}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
