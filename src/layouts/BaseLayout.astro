---
/*
  BaseLayout.astro

  What it is: the page shell every page on the site is wrapped in.
  Where it's used: src/pages/*.astro (each page passes a title and description).
  Which mockup it matches: none directly; it holds the <head>, fonts, favicons,
  and the night-colored page background from brand/brand-guide.md.

  The head also carries what search engines and link previews need: a canonical
  address, Open Graph and Twitter tags (the card shown when a link is shared, with
  the image in public/social/share.jpg), and the browser theme colour.

  The footer is rendered here for every page. The navigation is placed by each
  page inside its top frame (see Nav.astro), because the notch is cut into that frame.
*/

import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { siteName } from '../data/site';

interface Props {
  // The text shown in the browser tab and in search results.
  title: string;
  // One plain sentence describing the page, used in search results and link previews.
  description: string;
  // Set on pages that should not appear in search results (such as the 404 page).
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// The full address of this page, for the canonical link and link previews.
// Astro.site comes from `site` in astro.config.mjs (https://jadeagentic.com).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// The picture shown when the page is shared (1200 x 630).
const shareImageUrl = new URL('/social/share.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Marks the page as script-enabled before first paint. The hero's entrance
      animation only hides content when this class is present, so visitors
      without scripting always see the full text.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#16261c" />

    <!-- ===== LINK PREVIEWS: the card shown when the page is shared ===== -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Jade Agentic: Websites built to represent you."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />

    <!-- ===== FAVICONS: the jade bonsai disc, from public/logo/ ===== -->
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/logo/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/logo/favicon-192.png"
    />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />

    <!-- ===== FONTS: Cormorant Garamond, Instrument Sans, JetBrains Mono =====
      Loaded without blocking the first paint: the page shows straight away in a
      fallback font, then swaps to the real fonts when they arrive (display=swap).
      The stylesheet is requested as a preload and switched on once it has loaded;
      the <noscript> line covers visitors with scripting off. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Instrument+Sans:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Instrument+Sans:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
      />
    </noscript>
  </head>

  <body class="bg-night text-ivory min-h-screen">
    <!-- ===== SKIP LINK: lets keyboard users jump past the navigation ===== -->
    <a
      href="#main"
      class="focus:bg-ivory focus:text-night sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:px-5 focus:py-3"
    >
      Skip to content
    </a>

    <!-- ===== PAGE CONTENT: each page supplies its own frame and nav ===== -->
    <slot />

    <!-- ===== FOOTER: the same on every page ===== -->
    <Footer />
  </body>
</html>

<style is:global>
  /*
    Starting state for the scroll reveal (see src/scripts/reveal.ts). It only
    applies when scripting is on (the `js` class on <html>) and the visitor has
    not asked for reduced motion, so content is never left invisible.
    Hidden with opacity only, because GSAP owns the transform.
  */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal] {
      opacity: 0;
    }

    /* The letters of a scatter headline (see src/scripts/scatter-reveal.ts). */
    .js [data-char] {
      opacity: 0;
    }
  }
</style>

<script>
  import { initReveal } from '../scripts/reveal';
  import { initScatterReveal } from '../scripts/scatter-reveal';
  import { initFrameGrow } from '../scripts/frame-grow';

  initReveal();
  initScatterReveal();
  initFrameGrow();
</script>
