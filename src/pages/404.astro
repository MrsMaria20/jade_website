---
/*
  404.astro (the "page not found" page)

  What it is: what a visitor sees when they open an address that does not exist.
  Where it's used: the host shows it automatically for unknown addresses.
  Which mockup it matches: the short hero frames (field, doves, notched nav).

  It points the visitor home or to the booking page, and asks search engines not
  to list it (noindex).
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFrame from '../components/HeroFrame.astro';
import Button from '../components/Button.astro';
import { bookCallHref } from '../data/site';
---

<BaseLayout
  title="Page not found | Jade Agentic"
  description="That page isn't here. Head back to the Jade Agentic home page or book a call."
  noindex
>
  <main id="main">
    <HeroFrame variant="tall">
      <div class="flex min-h-[inherit] flex-col justify-end gap-6 px-6 pt-28 pb-10 lg:px-[60px] lg:pb-[58px]">
        <p data-hero-fade="0.2" class="eyebrow text-celadon">
          404
        </p>

        <h1
          data-hero-parallax
          class="font-serif text-[clamp(44px,7.6vw,104px)] leading-[0.9] font-normal tracking-[-0.03em] text-ivory"
        >
          <span class="-mb-[0.3em] block overflow-hidden pb-[0.3em]">
            <span class="hero-line block">That page</span>
          </span>
          <span class="-mb-[0.3em] block overflow-hidden pb-[0.3em]">
            <span class="hero-line block">isn't here.</span>
          </span>
        </h1>

        <p
          data-hero-fade="0.6"
          class="max-w-[560px] text-[17px] leading-relaxed text-mist"
        >
          The address may have changed, or it may have been typed wrong.
        </p>

        <div data-hero-fade="0.8" class="flex flex-wrap gap-2.5">
          <Button href="/">Back to home</Button>
          <Button href={bookCallHref} variant="secondary">
            Book a call
          </Button>
        </div>
      </div>
    </HeroFrame>
  </main>
</BaseLayout>
