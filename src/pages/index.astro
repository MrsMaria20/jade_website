---
/*
  index.astro (Home page, "/")

  What it is: the home page, in three parts: the hero, the services preview,
  and the dark contact panel. The footer is added by BaseLayout.astro.
  Which mockup it matches: heromockupex.png,
  reference/source/01-field-and-flight-v2.html (hero) and
  reference/source/02-ff2-site-home.html (the sections below it).
  Copy comes from site-plan.md.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFrame from '../components/HeroFrame.astro';
import GlassPanel from '../components/GlassPanel.astro';
import Button from '../components/Button.astro';
import ServicesPreview from '../components/ServicesPreview.astro';
import ClosingPanel from '../components/ClosingPanel.astro';
---

<BaseLayout
  title="Jade Agentic"
  description="Custom websites for small to medium businesses, built so your brand resonates with the people you want to reach."
>
  <main id="main">
    <HeroFrame variant="tall">
      <!--
        Phones and tablets: the pieces stack in one column (headline, then
        card). Desktop (lg and up): each piece is placed against the frame
        edges, as in the mockup.
      -->
      <div class="relative flex min-h-[inherit] flex-col justify-between gap-10 px-6 pt-28 pb-10 lg:block lg:p-0">
        <!-- ===== HEADLINE: bottom left, two lines that rise into place ===== -->
        <h1
          data-hero-parallax
          class="font-serif text-[clamp(44px,12.5vw,64px)] lg:text-[clamp(76px,8.2vw,118px)] leading-[0.86] font-normal tracking-[-0.03em] text-ivory lg:absolute lg:bottom-[58px] lg:left-[60px]"
        >
          <span class="-mb-[0.3em] block overflow-hidden pb-[0.3em]">
            <span class="hero-line block">Websites built</span>
          </span>
          <span class="-mb-[0.3em] block overflow-hidden pb-[0.3em]">
            <span class="hero-line block">to represent you</span>
          </span>
        </h1>

        <!-- ===== GLASS CARD: the blurb and the two buttons ===== -->
        <div
          data-hero-fade="0.9"
          class="lg:absolute lg:top-[150px] lg:right-[96px] lg:w-[420px]"
        >
          <GlassPanel variant="hero" class="flex flex-col gap-6 p-5! md:p-8!">
            <!--
              The blurb is three sentences. On phones only the first is shown,
              so the card stays short; tablets and up (md) show all three.
            -->
            <p class="text-[16px] leading-[1.65] text-mist">
              Custom websites for small to medium businesses, built so your
              brand resonates with the people you want to reach.{' '}
              <span class="hidden md:inline">
                We define what your site needs together, then handle every step
                from there. In [X] weeks, your site is live.
              </span>
            </p>
            <div class="flex flex-wrap gap-2.5">
              <Button href="/contact">Start a project</Button>
              <Button href="#services" variant="secondary">
                <!-- Shorter label on phones so both buttons fit on one row. -->
                <span class="sm:hidden">Services</span>
                <span class="hidden sm:inline">See our services</span>
              </Button>
            </div>
          </GlassPanel>
        </div>
      </div>
    </HeroFrame>

    <!-- ===== SERVICES PREVIEW: the two starting points and the three steps ===== -->
    <ServicesPreview />

    <!-- ===== CONTACT: book a call, email, and the coming-soon line ===== -->
    <ClosingPanel />
  </main>
</BaseLayout>
