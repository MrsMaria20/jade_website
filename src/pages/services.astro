---
/*
  services.astro (Services page, "/services")

  What it is: the Services page, in four panels: a short hero, the two starting
  points in more depth, what every project includes, and the contact panel.
  Which mockup it matches: reference/source/02-ff2-site-services.html (layout
  only; the add-ons picker and revision table are not built, see site-plan.md).
  Copy comes from site-plan.md. No prices appear anywhere on the site.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFrame from '../components/HeroFrame.astro';
import StartingPointsPanel from '../components/StartingPointsPanel.astro';
import EveryProjectPanel from '../components/EveryProjectPanel.astro';
import ClosingPanel from '../components/ClosingPanel.astro';
---

<BaseLayout
  title="Services | Jade Agentic"
  description="Two ways to start a website with Jade Agentic: Launch for one or two pages, Studio for a complete website."
>
  <main id="main">
    <!-- ===== HERO: full-screen frame with the field and doves ===== -->
    <HeroFrame variant="tall">
      <div class="flex min-h-[inherit] flex-col justify-end gap-6 px-6 pt-28 pb-10 lg:px-[60px] lg:pb-[58px]">
        <p data-hero-fade="0.2" class="eyebrow text-sage">
          jadeagentic.com / services
        </p>

        <!-- Two lines that rise into place, as on the home hero. -->
        <h1
          data-hero-parallax
          class="font-serif text-[clamp(44px,7.6vw,104px)] leading-[0.9] font-normal tracking-[-0.03em] text-ivory"
        >
          <span class="-mb-[0.3em] block overflow-hidden pb-[0.3em]">
            <span class="hero-line block">Two ways to start.</span>
          </span>
          <span class="-mb-[0.3em] block overflow-hidden pb-[0.3em]">
            <span class="hero-line block">Both built around you.</span>
          </span>
        </h1>

        <p
          data-hero-fade="0.9"
          class="max-w-[560px] text-[17px] leading-relaxed text-mist"
        >
          Every site is designed around your business. Pick a starting point,
          and we confirm the exact scope on a call.
        </p>
      </div>
    </HeroFrame>

    <!-- ===== STARTING POINTS: Launch and Studio in more depth ===== -->
    <StartingPointsPanel />

    <!-- ===== EVERY PROJECT: what you get either way ===== -->
    <EveryProjectPanel />

    <!-- ===== CONTACT: the same closing panel as the home page ===== -->
    <ClosingPanel />
  </main>
</BaseLayout>
