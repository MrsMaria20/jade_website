{
  "color": {
    "night":     { "value": "#16261C", "use": "Page background, navigation notch, footer" },
    "field":     { "value": "#1B2E22", "use": "Hero and closing panels, behind the blur" },
    "forest":    { "value": "#2E4A36", "use": "Icon circles inside buttons" },
    "shadow":    { "value": "#14231A", "use": "Deepest tone in the blurred field" },
    "ivory":     { "value": "#EFEBDF", "use": "Headlines and primary buttons on dark", "contrast": "13.3:1 on night" },
    "mist":      { "value": "#C9D2C3", "use": "Body text and nav links on dark", "contrast": "10.2:1 on night" },
    "sage":      { "value": "#9DB592", "use": "Labels and highlights on dark", "contrast": "7.1:1 on night" },
    "celadon":   { "value": "#BFD3CC", "use": "Soft accent, selected states" },
    "porcelain": { "value": "#F4F1E8", "use": "The ASCII doves" },
    "paper":     { "value": "#E9E4D8", "use": "Light section background" },
    "card":      { "value": "#F2EEE4", "use": "Cards on paper" },
    "ink":       { "value": "#1C241F", "use": "Headlines and dark cards on paper", "contrast": "12.5:1 on paper" },
    "moss":      { "value": "#3A453E", "use": "Body text on paper", "contrast": "7.9:1 on paper" },
    "jade":      { "value": "#3F6E5E", "use": "Brand accent: labels, progress bars, active rings", "contrast": "4.6:1 on paper" },
    "lichen":    { "value": "#56665C", "use": "Small labels and captions on paper", "contrast": "4.8:1 on paper" },
    "fern":      { "value": "#7E927F", "use": "Large text on dark only", "contrast": "4.3:1 — fails for small text" },
    "leak":      { "value": "#D9E4C8", "use": "Light leaks painted into the field" }
  },
  "fieldPalette": ["#2E4A36", "#3E6048", "#56785A", "#7C9A74", "#14231A", "#9DB592", "#2A4232"],
  "font": {
    "serif": { "family": "Cormorant Garamond", "weights": [400, 500], "italic": true, "use": "Headlines, company name, section and card titles" },
    "sans":  { "family": "Instrument Sans", "weights": [400, 500], "use": "Body, navigation, buttons, forms (default)" },
    "mono":  { "family": "JetBrains Mono", "weights": [400], "use": "Uppercase labels, figure numbers, side text, the ASCII doves" },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Instrument+Sans:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
  },
  "typeScale": {
    "display":  { "font": "serif 400", "size": "168px desktop / ~66px mobile", "lineHeight": 0.86, "tracking": "-0.03em" },
    "section":  { "font": "serif 400", "size": "76px desktop / ~46px mobile", "lineHeight": 0.95, "tracking": "-0.02em" },
    "stage":    { "font": "serif 400", "size": "46px", "lineHeight": 1 },
    "card":     { "font": "serif 400", "size": "30–52px", "lineHeight": 1 },
    "wordmark": { "font": "serif 500", "size": "26px" },
    "body":     { "font": "sans 400", "size": "16–17px", "lineHeight": 1.6 },
    "nav":      { "font": "sans 400", "size": "15px" },
    "button":   { "font": "sans 500", "size": "15–16px" },
    "label":    { "font": "mono 400 uppercase", "size": "11–12px", "tracking": "0.18–0.2em" }
  },
  "radius": { "frame": "28px", "panel": "24px", "card": "22px", "control": "14px", "pill": "999px" },
  "spacing": { "frameInset": "16px", "sectionPaddingDesktop": "110–140px 104px", "navHeight": "72px", "navWidth": "780px", "notchCorner": "26px" },
  "glass": {
    "hero":  { "background": "rgba(239,235,223,.08)", "blur": "14px", "border": "1px solid rgba(239,235,223,.16)", "radius": "22px" },
    "panel": { "background": "rgba(239,235,223,.06)", "blur": "10px", "border": "1px solid rgba(239,235,223,.14)", "radius": "24px" }
  },
  "motion": { "ease": "cubic-bezier(.2,.7,.15,1)", "reveal": "1.1–1.3s", "headlineStagger": "0.16s per line", "fieldDrift": "38s alternate" }
}
